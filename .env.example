GEMINI_API_KEY=
# Paste your key from Google AI Studio (no quotes). File must sit next to package.json.

# Optional overrides: .env.local (gitignored) wins over .env

# Loaded by Vite dev server middleware for Gemini routes — restart after editing.

GEMINI_MODEL=gemini-2.0-flash

VITE_API_ORIGIN=


# Firebase (Google Sign-In + Firestore mirror) — optional cloud sync

VITE_FIREBASE_API_KEY=

VITE_FIREBASE_AUTH_DOMAIN=

VITE_FIREBASE_PROJECT_ID=

VITE_FIREBASE_STORAGE_BUCKET=

VITE_FIREBASE_MESSAGING_SENDER_ID=

VITE_FIREBASE_APP_ID=


# GA4 measurement ID (optional — trackEvent wires gtag when set)

VITE_GA_MEASUREMENT_ID=

